# Budgets facultatifs côté serveur. Les valeurs ci-dessous sont les valeurs par défaut.
# Ne pas préfixer ces paramètres par VITE_. Aucune clé IGN n'est nécessaire.
ROUTING_MAX_EVENTS=240000
ROUTING_MAX_LABELS=50000
ROUTING_MAX_LABELS_PER_STOP=64
ROUTING_MAX_BOARD_STOPS=1600
ROUTING_MAX_WALK_REQUESTS=48
ROUTING_MAX_ACCESS_SECONDS=1200
ROUTING_RADIUS_METERS=1200
ROUTING_DEADLINE_MS=45000

# Carte : osm (fond public, usage interactif modéré) ou none (sans tuiles distantes).
# Aucune clé secrète. Voir docs/CARTE-INTERACTIVE.md avant une diffusion publique.
VITE_MAP_PROVIDER=osm

# Accès Data Grand Lyon : variables serveur uniquement. Pour le stockage local
# persistant sous Windows, utiliser npm run realtime:init (DPAPI CurrentUser).
# Ne renseigner aucun mot de passe dans ce fichier exemple ou dans VITE_*.
GRANDLYON_POLICY_CONFIRMED=false
GRANDLYON_MAPPING_CONFIRMED=false
GRANDLYON_MIN_INTERVAL_MS=60000
GRANDLYON_CACHE_TTL_MS=60000
GRANDLYON_MAX_AGE_MS=120000
